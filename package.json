{
	"name": "astra-motion",
	"version": "0.0.1",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint --pack false --strict",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:guide": "node scripts/check-motion-guide.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:server": "vitest run --project server",
		"test:browsers": "vitest run --config vitest.motion.config.ts",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:motion": "vitest run src/lib/motion-lab src/lib/motion/routes.spec.ts",
		"test:motion:e2e": "playwright test --config playwright.motion.config.ts"
	},
	"files": [
		"dist/index.js",
		"dist/index.d.ts",
		"dist/motion",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./layout": {
			"types": "./dist/motion/layout.d.ts",
			"svelte": "./dist/motion/layout.js",
			"default": "./dist/motion/layout.js"
		},
		"./presence": {
			"types": "./dist/motion/presence-entry.d.ts",
			"svelte": "./dist/motion/presence-entry.js",
			"default": "./dist/motion/presence-entry.js"
		},
		"./routes": {
			"types": "./dist/motion/routes.d.ts",
			"svelte": "./dist/motion/routes.js",
			"default": "./dist/motion/routes.js"
		},
		"./policy": {
			"types": "./dist/motion/policy.d.ts",
			"svelte": "./dist/motion/policy.js",
			"default": "./dist/motion/policy.js"
		},
		"./state": {
			"types": "./dist/motion/motion.svelte.d.ts",
			"svelte": "./dist/motion/motion.svelte.js",
			"default": "./dist/motion/motion.svelte.js"
		},
		"./values": {
			"types": "./dist/motion/values.d.ts",
			"svelte": "./dist/motion/values.js",
			"default": "./dist/motion/values.js"
		},
		"./animate": {
			"types": "./dist/motion/animate.d.ts",
			"svelte": "./dist/motion/animate.js",
			"default": "./dist/motion/animate.js"
		},
		"./scroll": {
			"types": "./dist/motion/scroll.svelte.d.ts",
			"svelte": "./dist/motion/scroll.svelte.js",
			"default": "./dist/motion/scroll.svelte.js"
		},
		"./state/lite": {
			"types": "./dist/motion/lite.svelte.d.ts",
			"svelte": "./dist/motion/lite.svelte.js",
			"default": "./dist/motion/lite.svelte.js"
		},
		"./in-view": {
			"types": "./dist/motion/in-view.svelte.d.ts",
			"svelte": "./dist/motion/in-view.svelte.js",
			"default": "./dist/motion/in-view.svelte.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.70.3",
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.40.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"layerchart": "^2.3.1",
		"magic-string": "0.30.21",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"shadcn-svelte": "^1.6.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"motion": "13.2.0",
		"motion-dom": "13.2.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	}
}
