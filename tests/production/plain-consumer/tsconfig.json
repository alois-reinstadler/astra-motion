{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": false,
		"allowJs": true,
		"checkJs": false,
		"resolveJsonModule": true,
		"types": ["vite/client", "svelte", "node"]
	},
	"include": ["src/**/*", "vite.config.ts"]
}
