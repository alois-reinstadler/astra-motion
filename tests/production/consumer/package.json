		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"vite": "8.2.2",
		"typescript": "6.0.3",
		"svelte-check": "4.7.6",
		"@sveltejs/adapter-node": "5.5.7"
	}
}
