{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["svelte", "vite/client", "@webgpu/types"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
