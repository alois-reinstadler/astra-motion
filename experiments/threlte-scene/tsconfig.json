{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["svelte", "vite/client"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.mjs", "src/**/*.svelte", "vite.config.ts"],
	"exclude": ["src/*.test.mjs"]
}
